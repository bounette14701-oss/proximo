# ============================================================
# Proximo — Variables d'environnement (copier en .env et remplacer)
# Tous les secrets DOIVENT être changés avant tout déploiement.
# ============================================================

# ─── Base de données ─────────────────────────────────────────
POSTGRES_PASSWORD=changez-moi-64-caracteres-hex
DATABASE_URL=postgresql://proximo:changez-moi-64-caracteres-hex@db:5432/proximo?schema=public

# ─── Authentification (JWT) ──────────────────────────────────
JWT_ACCESS_SECRET=changez-moi-secret-access-32-octets-min
JWT_REFRESH_SECRET=changez-moi-secret-refresh-32-octets-min
JWT_ACCESS_TTL=900
# Durée du refresh token en secondes (30 jours par défaut ;
# "Se souvenir de moi" = 90 jours automatiquement).
JWT_REFRESH_TTL=2592000

# ─── Application ─────────────────────────────────────────────
# Origines autorisées (CORS + garde anti-CSRF), séparées par des virgules.
CORS_ORIGINS=https://votre-domaine.example
# Port HTTP exposé par nginx.
HTTP_PORT=8080
# URLs publiques (utilisées par les emails et les QR codes).
APP_URL=https://votre-domaine.example
FRONTEND_URL=https://votre-domaine.example
API_URL=https://votre-domaine.example/api

# ─── Sprint 2 : administrateurs bootstrap ────────────────────
# Emails déclarés administrateurs dès l'inscription (séparés par des virgules).
# Un admin est ACTIVE d'emblée ; les autres comptes sont PENDING jusqu'à validation.
ADMIN_EMAILS=

# ─── Sprint 2 : Google OAuth2 (OpenID Connect) ───────────────
# Console Google Cloud → Credentials → OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être déclarée dans Google comme redirect URI autorisé :
# https://votre-domaine.example/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# ─── Emails (Brevo recommandé — offre gratuite 300 emails/jour) ───
# Clé API Brevo (Settings → API Keys) — l'IP du serveur doit être ajoutée
# dans Settings → Security → Authorized IPs.
BREVO_API_KEY=
# Expéditeur VÉRIFIÉ chez Brevo (Settings → Senders) — ex. votre email Brevo
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Proximo

# ─── SMTP générique (alternative à Brevo, Nodemailer) ───
# Sans SMTP ni Brevo configurés, les emails sont journalisés (développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Proximo <no-reply@proximo.local>
# Destinataire par défaut des signalements d'incidents
# (surchargé par les réglages syndic du back-office).
SYNDIC_EMAIL=

# ─── Sprint 2 : pièces jointes ───────────────────────────────
# Répertoire de stockage (volume Docker monté sur /data/uploads).
# UPLOAD_DIR=/data/uploads
