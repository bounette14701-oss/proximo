# ============================================================
# Proximo — Variables d'environnement (copier vers .env)
#   cp .env.example .env
# Tous les secrets DOIVENT être remplacés avant mise en production.
# Génération de secrets sûrs :
#   openssl rand -hex 32
# ============================================================

# --- Base de données (conteneur Docker "db") ---
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32

# --- Backend ---
# Secrets JWT (2 secrets distincts : access court, refresh long)
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-32

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Durées de vie des tokens (en secondes)
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 jours

# --- Frontend ---
# URL de l'API utilisée par le navigateur (vide = même origine via Nginx)
NEXT_PUBLIC_API_URL=

# --- Nginx ---
# Port HTTP exposé sur la machine hôte
HTTP_PORT=8080
